{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first translation workspace for Windows",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@8.9.0",
  "scripts": {
    "format": "biome format --write",
    "lint": "biome lint",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sqlite": "electron scripts/smoke-sqlite.mjs",
    "smoke:net": "electron scripts/smoke-net-fetch.mjs",
    "dev": "electron --version && electron-vite dev",
    "preview": "electron --version && electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "docx": "^9.8.1",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reicon-react": "1.2.6",
    "tailwind-merge": "3.7.0",
    "undici": "7.29.1",
    "valibot": "1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
